--!strict
-- Mutation definitions. Only Id, DisplayName, Category, RarityTier and BaseWeight
-- are required; every other rule field is optional and means "no restriction".
-- BaseWeight is the weight *within its category+tier pool*, not an overall chance.
--
-- GameplayModifiers are additive fractions (IncomeRate = 0.05 means +5%) or flat
-- (Power). Totals are clamped by MonsterGenerationService.

export type Mutation = {
	Id: string,
	DisplayName: string,
	Description: string,
	Category: string,
	RarityTier: number,
	BaseWeight: number,
	Element: string?,
	RequiredAttachment: string?,
	AllowedSpecies: { string }?,
	ExcludedSpecies: { string }?,
	AllowedBiomes: { string }?,
	RequiredElements: { string }?,
	ExcludedElements: { string }?,
	RequiredCatalysts: { string }?,
	RequiredEvents: { string }?,
	RequiredResearch: { string }?,
	MinimumProgression: number?,
	Environment: { [string]: { number } }?,
	IncompatibleMutations: { string }?,
	ExclusiveGroup: string?,
	GameplayModifiers: { [string]: number }?,
	Visual: { [string]: any }?,
}

