-- Verdant-themed mutations only form in Verdant Meadows, so each biome has its own
-- pool. Utility traits (Efficient, Adaptive, Hardy) stay available everywhere.
local VERDANT_ONLY = {
	"DewdropEyes", "PebblePlating", "SmallHornBuds", "CloverCrown", "Springtail", "AncientBarkArmour",
	"BioluminescentLeaves", "LivingGrove", "LeafMarkings", "MossyCoat", "VerdantSpots", "CrystalDew",
	"SoftGlow", "WildflowerAura", "EternalSpring", "Thornbound", "VerdantGuardian", "ElderwoodHeart", "WorldtreeSeed",
}

Mutations.ById = {} :: { [string]: Mutation }
for _, m in Mutations.List do
	assert(Mutations.ById[m.Id] == nil, "duplicate mutation id " .. m.Id)
	Mutations.ById[m.Id] = m
end
for _, id in VERDANT_ONLY do
	local m = assert(Mutations.ById[id], "VERDANT_ONLY lists unknown mutation " .. id)
	m.AllowedBiomes = m.AllowedBiomes or { "VerdantMeadows" }
end

return Mutations
